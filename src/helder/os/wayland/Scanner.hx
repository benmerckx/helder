package helder.os.wayland;

using StringTools;

// The protocol bindings' generator (helder's wayland-scanner): a protocol's
// XML to a Haxe module of helder.os.wayland.protocol, run on Eval:
//
//   haxe -cp src --run helder.os.wayland.Scanner <out dir> <protocol.xml>...
//
// For each interface: an abstract over its proxy (WlSurface: Ptr) with a
// method per request (its arguments packed into wl_argument slots,
// Proxy.marshal: libwayland's wl_proxy_marshal_array_flags; a new_id
// returned as the new proxy, a destructor's flag set), an events class of
// nullable handlers (WlSurfaceEvents: enter, leave...) decoded from the
// dispatcher's wl_argument array (Proxy.listen), its enums as enum
// abstracts; and the module's interface table (names, versions, each
// message's signature and argument interfaces), which Interfaces makes into
// libwayland's wl_interface and wl_message structs at run time. The
// generated modules are checked in (tests/os/wayland.sh regenerates them
// from the system's XML and compares).
class Scanner {
	static function main() {
		var args = Sys.args();
		if (args.length < 2) {
			Sys.println("usage: Scanner <out dir> <protocol.xml>...");
			Sys.exit(2);
		}
		var out = args[0];
		for (path in args.slice(1)) {
			var xml = Xml.parse(sys.io.File.getContent(path)).firstElement();
			var r = generate(xml, haxe.io.Path.withoutDirectory(path));
			sys.io.File.saveContent(haxe.io.Path.join([out, r.module + ".hx"]), r.code);
			Sys.println("Scanner: " + path + " -> " + r.module + ".hx");
		}
	}

	// "wl_surface" -> "WlSurface", "zxdg_toplevel_decoration_v1" -> "ZxdgToplevelDecorationV1"
	public static function camel(s:String):String
		return [for (p in s.split("_")) p.length == 0 ? "" : p.charAt(0).toUpperCase() + p.substr(1)].join("");

	static function lowerCamel(s:String):String {
		var c = camel(s);
		var r = c.charAt(0).toLowerCase() + c.substr(1);
		return KEYWORDS.contains(r) ? r + "_" : r;
	}

	static final KEYWORDS = [
		"new", "class", "function", "var", "final", "default", "switch", "case", "return", "interface", "enum", "inline", "override", "dynamic", "extern",
		"operator", "package", "import", "static", "public", "private", "this", "super", "null", "true", "false", "in", "is", "cast", "untyped", "macro",
		"abstract", "typedef", "break", "continue", "do", "while", "for", "if", "else", "try", "catch", "throw"
	];

	static function elements(x:Xml, name:String):Array<Xml>
		return [for (e in x.elementsNamed(name)) e];

	// the signature libwayland's wl_message has: since, then each argument's
	// letter ('?' before a nullable one; a new_id without an interface: "sun")
	static function signature(m:Xml):String {
		var s = new StringBuf();
		var since = m.get("since");
		if (since != null && since != "1") s.add(since);
		for (a in elements(m, "arg")) {
			if (a.get("allow-null") == "true") s.add("?");
			var t = a.get("type");
			if (t == "new_id" && a.get("interface") == null) s.add("su");
			s.add(switch t {
				case "int": "i";
				case "uint": "u";
				case "fixed": "f";
				case "string": "s";
				case "object": "o";
				case "new_id": "n";
				case "array": "a";
				case "fd": "h";
				case _: throw "Scanner: an unknown type " + t;
			});
		}
		return s.toString();
	}

	// each argument slot's interface name (null: none), as wl_message.types
	static function types(m:Xml):Array<Null<String>> {
		var out:Array<Null<String>> = [];
		for (a in elements(m, "arg")) {
			if (a.get("type") == "new_id" && a.get("interface") == null) {
				out.push(null);
				out.push(null);
			}
			out.push(a.get("type") == "object" || a.get("type") == "new_id" ? a.get("interface") : null);
		}
		return out;
	}

	public static function generate(protocol:Xml, file:String):{module:String, code:String} {
		var module = camel(protocol.get("name").replace("-", "_")) + "Protocol";
		var b = new StringBuf();
		inline function line(s:String)
			b.add(s + "\n");
		line("package helder.os.wayland.protocol;");
		line("");
		line("import helder.os.wayland.Proxy;");
		line("import hxmc.unsafe.*;");
		line("");
		line('// Generated by helder.os.wayland.Scanner from $file (the ${protocol.get("name")} protocol): do not edit.');
		line("");
		// (the interface table)
		var ifaces = elements(protocol, "interface");
		line('class $module {');
		line("\tpublic static final interfaces:Array<helder.os.wayland.Interfaces.InterfaceDef> = [");
		for (i in ifaces) {
			var reqs = [for (r in elements(i, "request")) msg(r)].join(", ");
			var evs = [for (e in elements(i, "event")) msg(e)].join(", ");
			line('\t\t{name: "${i.get("name")}", version: ${i.get("version")}, requests: [$reqs], events: [$evs]},');
		}
		line("\t];");
		line("}");
		var known = [for (i in ifaces) i.get("name")];
		for (i in ifaces) {
			var name = i.get("name"), cls = camel(name);
			line("");
			line('abstract $cls(Ptr) from Ptr to Ptr {');
			line('\tpublic static inline var NAME = "$name";');
			line('\tpublic static inline var VERSION = ${i.get("version")};');
			line("");
			line("\t// (its wl_interface, Interfaces')");
			line('\tpublic static var iface(get, never):Ptr;');
			line("");
			line('\tstatic inline function get_iface():Ptr');
			line('\t\treturn helder.os.wayland.Interfaces.get(NAME);');
			line("");
			line("\tpublic inline function isNull():Bool");
			line("\t\treturn this.isNull();");
			var ops = 0;
			for (r in elements(i, "request")) {
				request(b, r, ops++, cls, known);
			}
			var evs = elements(i, "event");
			if (evs.length > 0) {
				line("");
				line('\t// its events to e\'s handlers (one listener a proxy; Proxy.forget the slot returned)');
				line('\tpublic inline function listen(e:${cls}Events):Int');
				line("\t\treturn Proxy.listen(this, e);");
			}
			line("}");
			// events
			if (evs.length > 0) {
				line("");
				line('class ${cls}Events implements Proxy.Dispatcher {');
				for (e in evs)
					line('\tpublic var ${lowerCamel(e.get("name"))}:Null<(${[for (a in elements(e, "arg")) lowerCamel(a.get("name")) + ":" + argType(a, known)].join(", ")}) -> Void> = null;');
				line("");
				line("\tpublic function new() {}");
				line("");
				line("\tpublic function dispatch(opcode:Int, args:Ptr<Int64>):Void {");
				line("\t\tswitch opcode {");
				var k = 0;
				for (e in evs) {
					var h = lowerCamel(e.get("name"));
					var slot = 0;
					var vals = [for (a in elements(e, "arg")) decode(a, slot++, known)];
					line('\t\t\tcase $k: if ($h != null) $h(${vals.join(", ")});');
					k++;
				}
				line("\t\t\tcase _:");
				line("\t\t}");
				line("\t}");
				line("}");
			}
			// enums
			for (en in elements(i, "enum")) {
				line("");
				line('enum abstract $cls${camel(en.get("name"))}(Int) from Int to Int {');
				for (e in elements(en, "entry")) {
					var n = camel(e.get("name"));
					if (~/^[0-9]/.match(n)) n = "_" + n;
					line('\tvar $n = ${e.get("value")};');
				}
				line("}");
			}
		}
		return {module: module, code: b.toString()};
	}

	static function msg(m:Xml):String {
		var t = [for (x in types(m)) x == null ? "null" : '"$x"'].join(", ");
		return '{name: "${m.get("name")}", signature: "${signature(m)}", types: [$t]}';
	}

	static function argType(a:Xml, known:Array<String>):String
		return switch a.get("type") {
			case "int" | "uint" | "fd": "Int";
			case "fixed": "Float";
			case "string": "Null<String>";
			case "array": "Ptr";
			case "object" | "new_id":
				var i = a.get("interface");
				i != null && (known.contains(i) || CORE.contains(i)) ? qualified(i) : "Ptr";
			case t: throw "Scanner: an unknown type " + t;
		}

	// (core's interfaces, which every other protocol's refer to)
	static final CORE = [
		"wl_display", "wl_registry", "wl_callback", "wl_compositor", "wl_shm_pool", "wl_shm", "wl_buffer", "wl_data_offer", "wl_data_source", "wl_data_device",
		"wl_data_device_manager", "wl_shell", "wl_shell_surface", "wl_surface", "wl_seat", "wl_pointer", "wl_keyboard", "wl_touch", "wl_output", "wl_region",
		"wl_subcompositor", "wl_subsurface", "wl_fixes"
	];

	static function qualified(i:String):String
		return CORE.contains(i) ? "helder.os.wayland.protocol.WaylandProtocol." + camel(i) : camel(i);

	static function decode(a:Xml, slot:Int, known:Array<String>):String
		return switch a.get("type") {
			case "int" | "fd": 'Proxy.int(args, $slot)';
			case "uint": 'Proxy.uint(args, $slot)';
			case "fixed": 'Proxy.fixed(args, $slot)';
			case "string": 'Proxy.string(args, $slot)';
			case "array": 'Proxy.ptr(args, $slot)';
			case "object" | "new_id": 'Proxy.ptr(args, $slot)';
			case t: throw "Scanner: an unknown type " + t;
		}

	static function request(b:StringBuf, r:Xml, opcode:Int, cls:String, known:Array<String>) {
		inline function line(s:String)
			b.add(s + "\n");
		var name = lowerCamel(r.get("name"));
		var args = elements(r, "arg");
		var params = [], packs = [], slot = 0, ret = "Void", newIface = "Ptr.nil()", generic = false;
		for (a in args) {
			var an = lowerCamel(a.get("name"));
			switch a.get("type") {
				case "new_id":
					if (a.get("interface") == null) {
						// (wl_registry.bind: the interface and version named by the caller)
						generic = true;
						params.push("iface:Ptr");
						params.push("version:Int");
						packs.push('Proxy.setString(a, args, $slot, Proxy.interfaceName(iface));');
						packs.push('args[${slot + 1}] = version;');
						slot += 2;
						packs.push('args[$slot] = 0;');
						ret = "Ptr";
						newIface = "iface";
					} else {
						packs.push('args[$slot] = 0;');
						ret = qualified(a.get("interface"));
						if (!known.contains(a.get("interface")) && !CORE.contains(a.get("interface"))) ret = "Ptr";
						newIface = 'helder.os.wayland.Interfaces.get("${a.get("interface")}")';
					}
				case "int" | "uint" | "fd":
					params.push('$an:Int');
					packs.push('args[$slot] = $an;');
				case "fixed":
					params.push('$an:Float');
					packs.push('args[$slot] = Std.int($an * 256);');
				case "string":
					params.push('$an:${a.get("allow-null") == "true" ? "Null<String>" : "String"}');
					packs.push('Proxy.setString(a, args, $slot, $an);');
				case "object":
					params.push('$an:${argType(a, known)}');
					packs.push('args[$slot] = ($an : Ptr).toI64();');
				case "array":
					params.push('$an:Ptr');
					packs.push('args[$slot] = $an.toI64();');
				case t: throw "Scanner: an unknown type " + t;
			}
			slot++;
		}
		var destroy = r.get("type") == "destructor";
		var version = generic ? "version" : "-1";
		line("");
		line('\tpublic inline function $name(${params.join(", ")}):$ret {');
		line('\t\tvar r = Arena.scopedValue(a -> {');
		line('\t\t\tvar args:Ptr<Int64> = a.alloc(${Std.int(Math.max(1, slot)) * 8});');
		for (p in packs)
			line('\t\t\t$p');
		line('\t\t\tProxy.marshal(this, $opcode, $newIface, $version, ${destroy ? 1 : 0}, args, $slot);');
		line("\t\t});");
		if (ret != "Void") line("\t\treturn r;");
		line("\t}");
	}
}
