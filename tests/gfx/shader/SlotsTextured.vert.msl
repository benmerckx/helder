#include <metal_stdlib>
using namespace metal;
struct SlotVertex {
	float2 pos;
};
struct SlotView {
	float4 scale;
};
struct SlotVaryings {
	float4 clip;
	float2 uv;
};
SlotVaryings vs(SlotVertex v, SlotView view) {
	float2 at = v.pos * view.scale.xy;
	return SlotVaryings{float4(at, 0.0, 1.0), v.pos};
}
struct SlotView_buffer {
	float4 scale;
};
struct StageIn {
	float2 pos [[attribute(0)]];
};
struct StageOut {
	float4 clip [[position]];
	float2 uv [[user(locn0)]];
};
vertex StageOut main0(StageIn i [[stage_in]], constant SlotView_buffer& u_0 [[buffer(0)]]) {
	SlotVaryings r = vs(SlotVertex{i.pos}, SlotView{u_0.scale});
	return StageOut{r.clip, r.uv};
}
