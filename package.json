{
  "name": "helder",
  "version": "0.1.0",
  "description": "An experimental app and GUI stack in Haxe",
  "license": "MIT",
  "files": [
    "src/"
  ],
  "bin": {
    "helder": "src/helder/cli/run.mjs"
  },
  "exports": {
    "./view": {
      "types": "./src/helder/view/index.d.ts"
    },
    "./ui": {
      "types": "./src/helder/ui/index.d.ts"
    },
    "./web": {
      "types": "./src/helder/web/index.d.ts"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "haxe": {
    "name": "helder",
    "classPath": "src"
  },
  "scripts": {
    "test": "haxe -cp tests --run Run",
    "helder": "node src/helder/cli/run.mjs",
    "site": "node site/build.mjs",
    "site:check": "node site/check.mjs"
  },
  "peerDependencies": {
    "@hxmc/cli": ">=0.1.0-0",
    "typescript": ">=7.1.0-0"
  },
  "devDependencies": {
    "@hxmc/cli": "0.1.0-nightly.20261029.51c98c1",
    "@hxmc/source": "0.1.0-nightly.20261029.51c98c1",
    "typescript": "7.1.0-beta"
  },
  "trustedDependencies": [
    "@hxmc/cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benmerckx/universe.git"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
