{
  "name": "helder",
  "version": "0.1.0",
  "description": "An experimental app and GUI stack in Haxe",
  "license": "MIT",
  "files": [
    "src/"
  ],
  "bin": {
    "helder": "src/helder/cli/run.mjs"
  },
  "exports": {
    "./view": {
      "types": "./src/helder/view/index.d.ts"
    },
    "./ui": {
      "types": "./src/helder/ui/index.d.ts"
    },
    "./ui/actions": {
      "types": "./src/helder/ui/actions/index.ts"
    },
    "./ui/actions/runtime": {
      "types": "./src/helder/ui/actions/runtime.d.ts"
    },
    "./web": {
      "types": "./src/helder/web/index.d.ts"
    },
    "./canvas": {
      "types": "./src/helder/canvas/index.d.ts"
    },
    "./async": {
      "types": "./src/helder/async/index.d.ts"
    },
    "./gfx": {
      "types": "./src/helder/gfx/index.ts"
    },
    "./dev": {
      "types": "./src/helder/dev/index.d.ts"
    },
    "./asset": {
      "types": "./src/helder/asset/index.d.ts"
    },
    "./jobs": {
      "types": "./src/helder/jobs/index.d.ts"
    },
    "./story": {
      "types": "./src/helder/story/index.d.ts"
    },
    "./native": {
      "types": "./src/helder/native/index.ts"
    },
    "./native/runtime": {
      "types": "./src/helder/native/runtime.d.ts"
    },
    "./platform": {
      "types": "./src/helder/platform/index.ts"
    },
    "./test": {
      "types": "./src/helder/test/index.ts"
    },
    "./test/runner": {
      "types": "./src/helder/test/runner.d.ts"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "haxe": {
    "name": "helder",
    "classPath": "src"
  },
  "scripts": {
    "test": "haxe -cp tests --run Run",
    "helder": "node src/helder/cli/run.mjs",
    "site": "node site/build.mjs",
    "site:check": "node site/check.mjs",
    "site:numbers": "node site/numbers.mjs"
  },
  "peerDependencies": {
    "@hxmc/cli": ">=0.1.0-0",
    "typescript": ">=7.1.0-0"
  },
  "devDependencies": {
    "@hxmc/cli": "0.1.0-nightly.20261105.8116c6e",
    "@hxmc/source": "0.1.0-nightly.20261105.8116c6e",
    "typescript": "7.1.0-dev.20261106.1"
  },
  "trustedDependencies": [
    "@hxmc/cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benmerckx/helder.git"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
