import Model;

// A typeface to start from: a round monoline sans drawn as Foundry draws,
// about fifty letters of a few knots each; the rest (b, p, q, u, O, S, the
// accented letters...) borrowed. Knots as [x, y] or [x, y, 1] for a
// corner; a line's centre sits half the pen above the baseline (42) and
// below the x-height (458), as the board's snapping puts it.
class Sample {
	public static function face():Face {
		var face = Model.empty("Pebble");
		for (char => lines in glyphs())
			face = Model.with(face, char, {lines: lines, parts: []});
		return face;
	}

	static function glyphs():Map<String, Array<Line>> {
		var n:Array<Array<Float>> = [[0, 300], [48, 412], [165, 458], [282, 412], [330, 300], [330, 42]];
		var e = arc(200, 250, 200, 208, 0, 318, 9);
		e[0] = [400, 250, 1];
		var g = arc(310, 350, 310, 308, 42, 360, 10);
		g[g.length - 1] = [620, 350, 1];
		g.push([390, 350]);
		var bowl = ring(190, 250, 190, 208);
		return [
			"a" => [bowl, l([[380, 458], [380, 42]])],
			"c" => [l(arc(200, 250, 200, 208, 42, 318, 8))],
			"d" => [bowl, l([[380, 698], [380, 42]])],
			"e" => [l([[0.0, 250.0]].concat(e))],
			"f" => [l([[230, 680], [160, 698], [100, 672], [80, 600], [80, 42]]), l([[0, 458], [210, 458]])],
			"g" => [bowl, l([[380, 458], [380, -60], [350, -150], [260, -188], [150, -188], [50, -150]])],
			"h" => [l([[0, 698], [0, 42]]), l(n)],
			"i" => [l([[0, 458], [0, 42]]), l([[0, 640]])],
			"j" => [l([[60, 458], [60, -90], [40, -160], [-30, -188]]), l([[60, 640]])],
			"k" => [l([[0, 698], [0, 42]]), l([[290, 458], [30, 210, 1], [300, 42]])],
			"l" => [l([[0, 698], [0, 42]])],
			"m" => [
				l([[0, 458], [0, 42]]),
				l([[0, 300], [38, 410], [130, 458], [222, 410], [260, 300], [260, 42]]),
				l([[260, 300], [298, 410], [390, 458], [482, 410], [520, 300], [520, 42]])
			],
			"n" => [l([[0, 458], [0, 42]]), l(n)],
			"o" => [ring(200, 250, 200, 208)],
			"r" => [l([[0, 458], [0, 42]]), l([[0, 300], [50, 415], [150, 458], [230, 446]])],
			"s" => [l([[345, 395], [290, 445], [190, 458], [75, 432], [40, 355], [100, 285], [265, 228], [355, 155], [335, 72], [220, 42], [100, 48], [22, 108]])],
			"t" => [l([[80, 640], [80, 130], [110, 60], [180, 42], [230, 50]]), l([[0, 458], [220, 458]])],
			"v" => [l([[0, 458], [190, 42, 1], [380, 458]])],
			"w" => [l([[0, 458], [135, 42, 1], [270, 458, 1], [405, 42, 1], [540, 458]])],
			"x" => [l([[0, 458], [360, 42]]), l([[360, 458], [0, 42]])],
			"y" => [l([[0, 458], [200, 50]]), l([[400, 458], [90, -188]])],
			"z" => [l([[10, 458], [360, 458, 1], [10, 42, 1], [370, 42]])],
			"A" => [l([[0, 42], [240, 658, 1], [480, 42]]), l([[90, 250], [390, 250]])],
			"B" => [
				l([[0, 658], [0, 42]]),
				l([[0, 658], [210, 658], [310, 620], [340, 520], [300, 420], [200, 380], [0, 380]]),
				l([[0, 380], [230, 380], [350, 330], [380, 210], [345, 90], [230, 42], [0, 42]])
			],
			"D" => [l([[0, 658], [0, 42]]), l([[0, 658], [220, 658], [390, 580], [460, 350], [390, 120], [220, 42], [0, 42]])],
			"E" => [l([[400, 658], [0, 658, 1], [0, 42, 1], [400, 42]]), l([[0, 350], [340, 350]])],
			"F" => [l([[400, 658], [0, 658, 1], [0, 42]]), l([[0, 350], [340, 350]])],
			"G" => [l(g)],
			"H" => [l([[0, 658], [0, 42]]), l([[440, 658], [440, 42]]), l([[0, 350], [440, 350]])],
			"J" => [l([[320, 658], [320, 210], [280, 90], [170, 42], [60, 80], [10, 160]])],
			"K" => [l([[0, 658], [0, 42]]), l([[420, 658], [30, 300, 1], [440, 42]])],
			"L" => [l([[0, 658], [0, 42, 1], [380, 42]])],
			"M" => [l([[0, 42], [0, 658, 1], [290, 180, 1], [580, 658, 1], [580, 42]])],
			"N" => [l([[0, 42], [0, 658, 1], [470, 42, 1], [470, 658]])],
			"P" => [l([[0, 658], [0, 42]]), l([[0, 658], [230, 658], [360, 610], [400, 500], [360, 390], [230, 340], [0, 340]])],
			"Q" => [ring(310, 350, 310, 308), l([[400, 170], [590, -20]])],
			"R" => [
				l([[0, 658], [0, 42]]),
				l([[0, 658], [230, 658], [360, 610], [400, 500], [360, 390], [230, 340], [0, 340]]),
				l([[230, 340], [420, 42]])
			],
			"T" => [l([[0, 658], [480, 658]]), l([[240, 658], [240, 42]])],
			"U" => [l([[0, 658], [0, 240], [55, 95], [230, 42], [405, 95], [460, 240], [460, 658]])],
			"Y" => [l([[0, 658], [250, 340, 1], [500, 658]]), l([[250, 340], [250, 42]])],
			"0" => [ring(210, 350, 210, 308)],
			"1" => [l([[40, 560], [190, 658, 1], [190, 42]])],
			"2" => [l([[30, 540], [80, 628], [210, 658], [340, 625], [390, 530], [350, 420], [20, 42, 1], [400, 42]])],
			"3" => [
				l([[40, 600], [150, 655], [290, 650], [370, 570], [340, 440], [190, 380]]),
				l([[190, 380], [350, 330], [400, 210], [350, 85], [210, 42], [80, 62], [20, 130]])
			],
			"4" => [l([[320, 42], [320, 658, 1], [0, 200, 1], [440, 200]])],
			"5" => [l([[380, 658], [70, 658, 1], [40, 400, 1], [170, 420], [320, 395], [400, 270], [380, 110], [240, 42], [90, 60], [20, 130]])],
			"6" => [ring(210, 210, 210, 168), l([[330, 650], [190, 600], [60, 430], [0, 220]])],
			"7" => [l([[0, 658], [420, 658, 1], [130, 42]])],
			"8" => [ring(200, 510, 170, 148), ring(200, 200, 200, 158)],
			"." => [l([[0, 42]])],
			"," => [l([[40, 42], [0, -110]])],
			"-" => [l([[0, 260], [240, 260]])],
			"!" => [l([[0, 658], [0, 230]]), l([[0, 42]])],
			"?" => [l([[10, 560], [70, 635], [190, 658], [310, 625], [350, 540], [290, 440], [190, 390], [190, 240]]), l([[190, 42]])],
			"(" => [l([[170, 720], [50, 520], [10, 260], [50, 0], [170, -190]])],
			"/" => [l([[0, -120], [320, 720]])],
			"'" => [l([[0, 698], [0, 520]])],
			"´" => [l([[20, 560], [110, 690]])],
			"ˆ" => [l([[0, 560], [100, 670, 1], [200, 560]])],
			"¨" => [l([[0, 620]]), l([[150, 620]])],
			"˜" => [l([[0, 580], [50, 640], [120, 605], [190, 575], [240, 635]])],
			"¸" => [l([[60, 40], [60, -40], [130, -90], [70, -150], [0, -150]])],
			"¯" => [l([[0, 620], [200, 620]])],
			"˘" => [l([[0, 680], [30, 610], [100, 585], [170, 610], [200, 680]])],
			"˙" => [l([[0, 630]])],
			"˚" => [ring(60, 640, 52, 52)],
			"˝" => [l([[20, 560], [80, 690]]), l([[150, 560], [210, 690]])],
			"ˇ" => [l([[0, 680], [100, 570, 1], [200, 680]])],
			"˛" => [l([[110, 40], [50, -50], [70, -130], [150, -160]])],
			"ß" => [l([[0, 42], [0, 560], [40, 660], [140, 698], [250, 670], [300, 590], [270, 500], [170, 450], [300, 400], [380, 280], [360, 120], [270, 50], [150, 42]])],
			"ł" => [l([[100, 698], [100, 42]]), l([[0, 300], [200, 440]])],
			"ø" => [ring(200, 250, 200, 208), l([[0, 20], [400, 480]])],
			"æ" => [l([[0, 410], [100, 455], [220, 458], [300, 400], [310, 300], [310, 42]]), ring(150, 160, 150, 118), l([[310, 250], [640, 250, 1], [600, 400], [480, 458], [360, 400], [310, 280]]), l([[310, 160], [370, 70], [480, 42], [600, 70]])],
			"œ" => [ring(190, 250, 190, 208), l([[380, 250], [740, 250, 1], [700, 400], [570, 458], [440, 400], [380, 250], [440, 100], [570, 42], [710, 80]])],
			"đ" => [ring(190, 250, 190, 208), l([[380, 698], [380, 42]]), l([[280, 620], [470, 620]])],
			"Ł" => [l([[100, 658], [100, 42, 1], [460, 42]]), l([[0, 300], [220, 450]])],
			"Ø" => [ring(310, 350, 310, 308), l([[20, 20], [600, 680]])],
			"Đ" => [l([[60, 658], [60, 42]]), l([[60, 658], [280, 658], [450, 580], [520, 350], [450, 120], [280, 42], [60, 42]]), l([[0, 350], [220, 350]])]
		];
	}

	static function l(points:Array<Array<Float>>, closed = false):Line
		return {knots: [for (p in points) {x: p[0], y: p[1], corner: p.length > 2 && p[2] == 1}], closed: closed};

	static function ring(cx:Float, cy:Float, rx:Float, ry:Float):Line
		return l([for (i in 0...8) [cx + rx * Math.cos(i * Math.PI / 4), cy + ry * Math.sin(i * Math.PI / 4)]], true);

	// knots along an ellipse from one angle to another (degrees, anticlockwise)
	static function arc(cx:Float, cy:Float, rx:Float, ry:Float, from:Float, to:Float, n:Int):Array<Array<Float>>
		return [for (i in 0...n + 1) {
			var a = (from + (to - from) * i / n) * Math.PI / 180;
			[cx + rx * Math.cos(a), cy + ry * Math.sin(a)];
		}];
}
